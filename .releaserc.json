{
    "branches": [
        "main"
    ],
    "plugins": [
        [
            "@semantic-release/commit-analyzer",
            {
                "preset": "conventionalcommits"
            }
        ],
        [
            "@semantic-release/release-notes-generator",
            {
                "preset": "conventionalcommits"
            }
        ],
        [
            "@semantic-release/exec",
            {
                "prepareCmd": "rm -f package.json package-lock.json .releaserc.json && python update_version.py ${nextRelease.version} && uv_lock_path=$(find . -name uv.lock -type f -print -quit) && if [ -n \"$uv_lock_path\" ]; then uv lock --project \"$(dirname \"$uv_lock_path\")\"; fi",
                "verifyReleaseCmd": "echo \"${nextRelease.version}\" > release_version.txt",
                "generateNotesCmd": "cat >release_notes.txt <<'EOF${nextRelease.gitHead}EOF'\n${nextRelease.notes}\nEOF${nextRelease.gitHead}EOF"
            }
        ],
        [
            "@semantic-release/git",
            {
                "assets": [
                    "README.md",
                    "*.json",
                    "release_notes/*",
                    "pyproject.toml",
                    "uv.lock",
                    "**/*/uv.lock"
                ],
                "message": "chore(release): update version to ${nextRelease.version} [skip ci]"
            }
        ],
        "@semantic-release/github"
    ]
}
